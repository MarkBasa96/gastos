# Copy to .env.local and fill in. Both values are public by design (they ship in the web bundle);
# Row Level Security in supabase/schema.sql is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_YOUR_KEY
EXPO_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY   # optional; enables the Cloudflare bot check on "send me a code"
